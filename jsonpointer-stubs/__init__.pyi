from collections.abc import Iterable, Iterator
from re import Pattern
from typing import Any, Final, TypeVar

from typing_extensions import Self, deprecated

_T = TypeVar("_T")

__author__: Final[str]
__version__: Final[str]
__website__: Final[str]
__license__: Final[str]

VERBOSE_EXCEPTIONS: bool

def set_pointer(
    doc: Any,
    pointer: str,
    value: Any,
    inplace: bool = True,
    create: bool = False,
) -> Any: ...
def resolve_pointer(doc: Any, pointer: str, default: Any = ...) -> Any: ...
@deprecated("Use itertools.pairwise() instead")
def pairwise(iterable: Iterable[_T]) -> Iterator[tuple[_T, _T]]: ...

class JsonPointerException(Exception): ...

class EndOfList:
    list_: Any
    def __init__(self, list_: Any) -> None: ...

class JsonPointer:
    _RE_ARRAY_INDEX: Pattern[str]
    _RE_INVALID_ESCAPE: Pattern[str]
    parts: list[str]
    def __init__(self, pointer: str) -> None: ...
    def to_last(self, doc: Any) -> tuple[Any, str | int | None]: ...
    def resolve(self, doc: Any, default: Any = ...) -> Any: ...
    def get(self, doc: Any, default: Any = ...) -> Any: ...
    def set(
        self,
        doc: Any,
        value: Any,
        inplace: bool = True,
        create: bool = False,
    ) -> Any: ...
    @classmethod
    def get_part(cls, doc: Any, part: str | int) -> str | int: ...
    def get_parts(self) -> list[str]: ...
    def walk(self, doc: Any, part: str | int) -> Any: ...
    def contains(self, ptr: JsonPointer) -> bool: ...
    def __contains__(self, item: JsonPointer) -> bool: ...
    def join(self, suffix: JsonPointer | str | Iterable[object]) -> Self: ...
    def __truediv__(self, suffix: JsonPointer | str | Iterable[object]) -> Self: ...
    @property
    def path(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    @classmethod
    def from_parts(cls, parts: Iterable[object]) -> Self: ...

def escape(s: str) -> str: ...
def unescape(s: str) -> str: ...
